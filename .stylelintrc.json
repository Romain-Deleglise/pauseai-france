{
	"extends": ["stylelint-config-html/svelte"],
	"rules": {
		"color-no-hex": [
			true,
			{
				"message": "Couleur en dur : utilisez un token de la charte (var(--brand), var(--text), var(--bg-card)…). Voir docs/charte-graphique.md."
			}
		],
		"declaration-property-value-disallowed-list": [
			{ "text-align": ["justify"] },
			{
				"message": "Pas de texte justifié : sans césure fiable, il creuse des rivières de blancs."
			}
		],
		"color-named": [
			"never",
			{
				"ignoreProperties": ["/^--/"],
				"message": "Couleur nommée : utilisez un token de la charte (var(--white), var(--text)…)."
			}
		]
	},
	"overrides": [
		{
			"files": ["src/app.css"],
			"rules": { "color-no-hex": null, "color-named": null }
		},
		{
			"files": ["src/lib/layouts/waitbutwhy.svelte"],
			"rules": { "color-no-hex": null, "color-named": null }
		},
		{
			"files": [
				"src/lib/components/Logo.svelte",
				"src/lib/components/Header.svelte",
				"src/lib/components/hero/LeftCorner.svelte",
				"src/lib/components/ArticleTeaserCard.svelte",
				"src/lib/components/Footer.svelte",
				"src/lib/components/home/hero.svelte"
			],
			"rules": { "color-no-hex": null, "color-named": null }
		}
	],
	"ignoreFiles": ["build/**", ".svelte-kit/**", "node_modules/**", "static/**", "archive/**"]
}
